---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog-es');
---

<Layout title="The Sint Maarten — Guía y Vida en el Caribe Holandés en Español" lang="es">
  <section class="border-b border-slate-800 bg-[#08121e] py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-950/30 px-3.5 py-1 text-xs text-cyan-300 font-semibold mb-4">
        EDICIÓN EN ESPAÑOL
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-5xl">Guía de Viajes y Estilo de Vida en Sint Maarten</h1>
      <p class="mt-4 max-w-2xl text-slate-300 text-sm sm:text-base leading-relaxed font-light">
        La laguna de Simpson Bay, tiendas libres de impuestos en Philipsburg, las mejores playas y regatas internacionales.
      </p>
    </div>
  </section>

  <section class="py-12 bg-[#08121e]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map(post => (
          <article class="flex flex-col justify-between rounded-xl border border-slate-800 bg-[#0c1a2b]/50 p-6 hover:border-cyan-500/50 transition-colors">
            <div>
              <span class="rounded bg-cyan-950 px-2 py-0.5 text-[11px] text-cyan-300 font-semibold">{post.data.category}</span>
              <h2 class="text-lg font-bold text-white mt-3 hover:text-cyan-400 transition-colors">
                <a href={'/es/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-slate-400 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800 text-xs">
              <a href={'/es/' + post.id + '/'} class="text-cyan-400 hover:underline font-semibold">Leer Guía →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
