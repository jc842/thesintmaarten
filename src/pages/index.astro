---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const featuredPosts = sortedPosts.slice(0, 6);
const remainingPosts = sortedPosts.slice(6, 40);
---

<Layout title="The Sint Maarten — Dutch Caribbean Island Living & Guide : Simpson Bay, Philipsburg & Cupecoy">
  <!-- Hero Section Spaziobianco -->
  <section class="relative border-b border-slate-800/80 bg-[#08121e] py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-cyan-900/20 via-transparent to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      
      <!-- Top Pill -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-950/30 px-3.5 py-1.5 text-xs text-cyan-300 font-semibold">
        <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
        DUTCH CARIBBEAN ISLAND EXPERIENCE
      </div>

      <!-- Headline -->
      <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl max-w-4xl leading-tight">
        L'Énergie et le Style de <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-400">Sint Maarten</span>.
      </h1>

      <p class="mt-6 max-w-2xl text-base sm:text-lg text-slate-300 leading-relaxed font-light">
        La destination cosmopolite des Caraïbes néerlandaises : marinas internationales de superyachts, boutiques détaxées de Philipsburg, falaises dorées de Cupecoy et ferveur de Maho.
      </p>

      <!-- Key Pillars Row -->
      <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-6">
        <div class="rounded-xl border border-slate-800 bg-[#0d1c2e]/60 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-cyan-400 uppercase tracking-widest font-semibold">Simpson Bay</div>
          <div class="mt-2 text-2xl font-bold text-white">Superyachts</div>
          <div class="mt-1 text-xs text-slate-400">Capitale caribéenne du nautisme</div>
        </div>
        <div class="rounded-xl border border-slate-800 bg-[#0d1c2e]/60 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-cyan-400 uppercase tracking-widest font-semibold">Philipsburg</div>
          <div class="mt-2 text-2xl font-bold text-cyan-400">0% Taxes</div>
          <div class="mt-1 text-xs text-slate-400">Front Street duty-free shopping</div>
        </div>
        <div class="rounded-xl border border-slate-800 bg-[#0d1c2e]/60 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-cyan-400 uppercase tracking-widest font-semibold">Plages Remarquables</div>
          <div class="mt-2 text-2xl font-bold text-white">37 Plages</div>
          <div class="mt-1 text-xs text-slate-400">Mullet Bay, Cupecoy & Maho</div>
        </div>
        <div class="rounded-xl border border-slate-800 bg-[#0d1c2e]/60 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-cyan-400 uppercase tracking-widest font-semibold">Heineken Regatta</div>
          <div class="mt-2 text-2xl font-bold text-sky-400">Sailing Elite</div>
          <div class="mt-1 text-xs text-slate-400">Grand rendez-vous nautique</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Bento Articles -->
  <section class="py-16 sm:py-20 bg-[#08121e] border-b border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="text-xs uppercase tracking-widest text-cyan-400 font-semibold">Guides & Chroniques</span>
          <h2 class="text-2xl font-bold text-white sm:text-3xl mt-1">Dernières Publications & Découvertes</h2>
        </div>
        <a href="/blog/" class="hidden sm:inline-flex items-center gap-2 text-xs text-cyan-400 hover:text-cyan-300 font-semibold">
          TOUS LES ARTICLES →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredPosts.map((post) => (
          <article class="group relative flex flex-col justify-between rounded-xl border border-slate-800 bg-[#0c1a2b]/50 p-6 transition-all duration-300 hover:border-cyan-500/40 hover:bg-[#0c1a2b]/90">
            <div>
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-3">
                <span class="rounded bg-cyan-950 px-2 py-0.5 text-cyan-300 font-semibold">{post.data.category || 'SXM Guide'}</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors line-clamp-2 leading-snug">
                <a href={'/blog/' + post.id + '/'}>
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-3 text-xs text-slate-400 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
              <span class="text-slate-500">The Sint Maarten Magazine</span>
              <a href={'/blog/' + post.id + '/'} class="text-cyan-400 hover:underline flex items-center gap-1 font-semibold">
                Lire le guide →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Extended Library -->
  <section class="py-16 bg-[#060d16]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-white mb-8">
        Exploration de Sint Maarten : Quartiers, Événements & Nautisme
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {remainingPosts.map(post => (
          <div class="flex items-start justify-between rounded-lg border border-slate-800/80 bg-[#0a1624]/40 p-4 hover:border-cyan-900/60 transition-colors">
            <div class="pr-4">
              <span class="text-[10px] text-cyan-400 uppercase tracking-wider font-semibold">{post.data.category || 'Article'}</span>
              <h4 class="text-sm font-semibold text-slate-200 mt-1 hover:text-cyan-300 transition-colors">
                <a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
              </h4>
            </div>
            <a href={'/blog/' + post.id + '/'} class="text-xs text-cyan-400 whitespace-nowrap pt-1 font-semibold">
              Consulter →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
